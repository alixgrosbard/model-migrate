{
  "name": "sunsetdiff",
  "version": "1.0.0",
  "private": true,
  "description": "SunsetDiff tracks AI model retirements and the migration diff when you switch.",
  "author": "SunsetDiff",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sunsetdiff": "./service/dist/service/src/cli.js"
  },
  "scripts": {
    "prebuild": "tsx scripts/generate-static.ts",
    "build": "astro build && tsx scripts/verify-build.ts",
    "dev": "astro dev --host 0.0.0.0",
    "test": "vitest run",
    "scrape": "tsx scrapers/run.ts",
    "generate:static": "tsx scripts/generate-static.ts",
    "build:service": "tsc -p service/tsconfig.json",
    "start:service": "node service/dist/service/src/index.js",
    "build:action": "ncc build action/src/index.ts -o action/dist --target es2022"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "@hono/node-server": "^1.19.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "astro": "^5.14.0",
    "cheerio": "^1.1.2",
    "hono": "^4.9.0",
    "pg": "^8.23.1",
    "undici": "^7.16.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@actions/core": "^1.11.1",
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@vercel/ncc": "^0.38.3",
    "minimatch": "^10.0.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
