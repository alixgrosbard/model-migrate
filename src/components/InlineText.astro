---
interface Props { text: string; }
const { text } = Astro.props;

function parts(value: string): { text: string; href?: string }[] {
  const out: { text: string; href?: string }[] = [];
  const pattern = /\[([^\]]+)\]\((\/[^)\s]*|https:\/\/[^)\s]+)\)/g;
  let last = 0;
  for (const match of value.matchAll(pattern)) {
    const index = match.index ?? 0;
    if (index > last) out.push({ text: value.slice(last, index) });
    out.push({ text: match[1], href: match[2] });
    last = index + match[0].length;
  }
  if (last < value.length) out.push({ text: value.slice(last) });
  return out;
}
---
{parts(text).map((part) => part.href ? <a href={part.href}>{part.text}</a> : part.text)}
