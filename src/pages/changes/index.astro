---
import Base from "../../layouts/Base.astro";
import { loadChanges } from "../../lib/load.ts";
const changes = (await loadChanges()).slice().reverse().slice(0, 200);
function formatValue(value: unknown) {
  if (value == null) return "Not published";
  return typeof value === "string" ? value : JSON.stringify(value);
}
---
<Base title="What changed | SunsetDiff" description="Recent changes detected on official AI model deprecation pages." crumbs={[{ name: "Home", path: "/" }, { name: "Changes", path: "/changes/" }]}>
  <h1>What changed</h1>
  <p>Feed: <a href="/changes.xml">RSS</a></p>
  <table>
    <caption>Latest logged changes</caption>
    <thead><tr><th>Date</th><th>Provider</th><th>Model</th><th>Field</th><th>New value</th></tr></thead>
    <tbody>
      {changes.map((change) => (
        <tr>
          <td>{change.date}</td>
          <td>{change.provider}</td>
          <td>{change.model_id}</td>
          <td>{change.field}</td>
          <td>{formatValue(change.new)} <a href={change.source_url}>source</a></td>
        </tr>
      ))}
    </tbody>
  </table>
</Base>
