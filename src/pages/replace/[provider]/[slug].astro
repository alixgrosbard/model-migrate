---
import Base from "../../../layouts/Base.astro";
import MigrationCard from "../../../components/MigrationCard.astro";
import NewsletterForm from "../../../components/NewsletterForm.astro";
import SponsorSlot from "../../../components/SponsorSlot.astro";
import { loadMigrations, loadModels, loadProviders, migrationKey } from "../../../lib/load.ts";
import { answerSentence } from "../../../lib/format.ts";
import { migrateGraph } from "../../../jsonld.ts";

export async function getStaticPaths() {
  const models = await loadModels();
  return models.map((model) => ({ params: { provider: model.provider, slug: model.slug } }));
}
const models = await loadModels();
const providers = await loadProviders();
const migrations = await loadMigrations();
const model = models.find((item) => item.provider === Astro.params.provider && item.slug === Astro.params.slug);
if (!model) throw new Error("Missing model");
const provider = providers.find((item) => item.id === model.provider)!;
const cards = model.replacements.flatMap((replacement) => {
  const target = models.find((item) => item.provider === replacement.provider && item.id === replacement.model_id);
  if (!target) return [];
  const migration = migrations.find((item) => migrationKey(model.provider, model.slug, target.provider, target.slug) === `${item.from.provider}__${item.from.slug}__to__${item.to.provider}__${item.to.slug}`);
  return migration ? [{ migration, target, kind: replacement.kind }] : [];
});
const official = model.replacements.find((item) => item.kind === "official");
const answer = official
  ? `The official replacement for ${model.display_name} is ${official.model_id}.`
  : `No official replacement is published for ${model.display_name}.`;
const description = `Replacement for ${model.display_name}: price, context and code changes. ${answer}`;
const site = Astro.site?.href ?? "https://sunsetdiff.onrender.com/";
---
<Base
  title={`Replacement for ${model.display_name}: price, context and code changes | SunsetDiff`}
  description={description}
  crumbs={[
    { name: "Home", path: "/" },
    { name: provider.name, path: `/providers/${provider.id}/` },
    { name: model.display_name, path: `/replace/${model.provider}/${model.slug}/` },
  ]}
  extraGraph={migrateGraph(site, model, cards[0]?.migration, provider)}
>
  <h1>Replacement for {model.display_name}: what changes when you switch</h1>
  <p class="answer">{answer} {answerSentence(model, provider)}</p>
  {cards.length ? cards.map((card) => (
    <section>
      <p>{card.kind === "editorial" ? "Editorial suggestion." : "Official replacement."} <a href={`/migrate/${card.migration.from.provider}__${card.migration.from.slug}__to__${card.migration.to.provider}__${card.migration.to.slug}/`}>Full diff page</a></p>
      <MigrationCard migration={card.migration} from={model} to={card.target} />
    </section>
  )) : <p>A migration diff is not published because the official page did not name a replacement model id.</p>}
  <h2>Sources</h2>
  <ul>{model.sources.map((source) => <li><a href={source.url}>{source.label}</a> — checked {source.last_checked}</li>)}</ul>
  <SponsorSlot modelName={model.display_name} />
  <NewsletterForm providers={providers} sourcePage={`/replace/${model.provider}/${model.slug}/`} />
</Base>
