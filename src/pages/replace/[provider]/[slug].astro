---
import Base from "../../../layouts/Base.astro";
import FaqList from "../../../components/FaqList.astro";
import MigrationCard from "../../../components/MigrationCard.astro";
import NewsletterForm from "../../../components/NewsletterForm.astro";
import SponsorSlot from "../../../components/SponsorSlot.astro";
import { loadMigrations, loadModels, loadProviders, migrationKey } from "../../../lib/load.ts";
import { clipMeta, relatedModels, replaceFaqs, replacePageTitle, replacementAnswer, uniqueVisibleName, visibleName } from "../../../lib/format.ts";
import { isThinReplace, NOINDEX_FOLLOW } from "../../../lib/indexability.ts";
import { replaceHub } from "../../../lib/hubs.ts";
import { migrateGraph } from "../../../jsonld.ts";
import { DEFAULT_SITE_URL } from "../../../lib/site.ts";

export async function getStaticPaths() {
  const models = await loadModels();
  return models.map((model) => ({ params: { provider: model.provider, slug: model.slug } }));
}
const models = await loadModels();
const providers = await loadProviders();
const migrations = await loadMigrations();
const model = models.find((item) => item.provider === Astro.params.provider && item.slug === Astro.params.slug);
if (!model) throw new Error("Missing model");
const provider = providers.find((item) => item.id === model.provider)!;
const cards = model.replacements.flatMap((replacement) => {
  const target = models.find((item) => item.provider === replacement.provider && item.id === replacement.model_id);
  if (!target) return [];
  const migration = migrations.find((item) => migrationKey(model.provider, model.slug, target.provider, target.slug) === `${item.from.provider}__${item.from.slug}__to__${item.to.provider}__${item.to.slug}`);
  return migration ? [{ migration, target, kind: replacement.kind }] : [];
});
const migration = cards[0]?.migration;
const answer = replacementAnswer(model, provider, migration);
const faqs = replaceFaqs(model, provider, migration);
const related = relatedModels(model, models);
const description = clipMeta(answer);
const pageName = uniqueVisibleName(model, models, provider.name);
const site = Astro.site?.href ?? `${DEFAULT_SITE_URL}/`;
---
<Base
  title={replacePageTitle(model, models, provider.name)}
  description={description}
  robots={NOINDEX_FOLLOW}
  image={`/og/models/${model.provider}/${model.slug}.svg`}
  crumbs={[
    { name: "Home", path: "/" },
    { name: replaceHub.nav, path: replaceHub.path },
    { name: provider.name, path: `/providers/${provider.id}/` },
    { name: visibleName(model), path: `/replace/${model.provider}/${model.slug}/` },
  ]}
  extraGraph={migrateGraph(site, model, cards[0]?.migration, provider, `/replace/${model.provider}/${model.slug}/`, models)}
>
  <h1>Replacement for {pageName}: what changes when you switch</h1>
  <p class="answer">{answer}</p>
  <p><a href={`/models/${model.provider}/${model.slug}/`}>{visibleName(model)} model page</a> · <a href={`/providers/${provider.id}/`}>{provider.name}</a></p>
  {cards.length ? cards.map((card) => (
    <section>
      <p>{card.kind === "editorial" ? "Editorial suggestion." : "Official replacement."} <a href={`/migrate/${card.migration.from.provider}__${card.migration.from.slug}__to__${card.migration.to.provider}__${card.migration.to.slug}/`}>Full diff page</a></p>
      <MigrationCard migration={card.migration} from={model} to={card.target} />
    </section>
  )) : <p>A migration diff is not published because the official page did not name a replacement model id.</p>}
  <h2>Related models</h2>
  <ul>
    {related.map((item) => <li><a href={isThinReplace(item) ? `/models/${item.provider}/${item.slug}/` : `/replace/${item.provider}/${item.slug}/`}>{visibleName(item)}{isThinReplace(item) ? " model page" : " replacement"}</a></li>)}
  </ul>
  <FaqList items={faqs} />
  <h2>Sources</h2>
  <ul>{model.sources.map((source) => <li><a href={source.url}>{source.label}</a>, checked {source.last_checked}</li>)}</ul>
  <SponsorSlot modelName={visibleName(model)} />
  <NewsletterForm providers={providers} sourcePage={`/replace/${model.provider}/${model.slug}/`} />
</Base>
