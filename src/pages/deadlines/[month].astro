---
import Base from "../../layouts/Base.astro";
import { loadModels, loadProviders, providerName } from "../../lib/load.ts";
import { formatWindowDate, modelsInMonth, monthLabel, shutdownMonths } from "../../lib/growth.ts";

export async function getStaticPaths() {
  const months = shutdownMonths(await loadModels());
  return months.map((month) => ({ params: { month } }));
}

const month = Astro.params.month ?? "";
if (!/^\d{4}-\d{2}$/.test(month)) throw new Error("Missing month");
const providers = await loadProviders();
const rows = modelsInMonth(await loadModels(), month);
const label = monthLabel(month);
---
<Base
  title={`AI model shutdowns in ${label} | SunsetDiff`}
  description={`Models with a published shutdown date in ${label}. Dates come from official provider pages.`}
  crumbs={[{ name: "Home", path: "/" }, { name: "Deadlines", path: "/deadlines/" }, { name: label, path: `/deadlines/${month}/` }]}
>
  <h1>Shutdowns in {label}</h1>
  <p>
    Each row is a date published on an official page. "Not sooner than" is a floor, not a confirmed shutdown day.
    <a href="/deadlines/">All deadlines</a> · <a href="/deadlines.ics">iCal</a> · <a href="/feed.xml">RSS</a>
  </p>
  <table>
    <caption>Published shutdowns in {label}</caption>
    <thead><tr><th>When</th><th>Model</th><th>Provider</th><th>Status</th></tr></thead>
    <tbody>
      {rows.map((model) => (
        <tr>
          <td>{formatWindowDate(model)}</td>
          <td><a href={`/models/${model.provider}/${model.slug}/`}>{model.id}</a></td>
          <td><a href={`/providers/${model.provider}/`}>{providerName(providers, model.provider)}</a></td>
          <td>{model.status}</td>
        </tr>
      ))}
    </tbody>
  </table>
</Base>
