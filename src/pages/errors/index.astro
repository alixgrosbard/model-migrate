---
import Base from "../../layouts/Base.astro";
import FaqList from "../../components/FaqList.astro";
import { requestErrorsIndexGraph } from "../../jsonld.ts";
import {
  REQUEST_ERRORS_CHECKED,
  REQUEST_ERRORS_INDEX,
  requestErrorHubFaqs,
  requestErrorPath,
  requestErrorProviders,
  requestErrorsForProvider,
} from "../../lib/request-errors.ts";
import { DEFAULT_SITE_URL } from "../../lib/site.ts";

const site = Astro.site?.href ?? `${DEFAULT_SITE_URL}/`;
const checked = new Date(`${REQUEST_ERRORS_CHECKED}T00:00:00Z`).toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
const items = requestErrorProviders.flatMap((provider) =>
  requestErrorsForProvider(provider.id).map((page) => ({ name: page.h1, path: requestErrorPath(page.slug) })),
);
---
<Base
  title="Request errors after an AI model change | SunsetDiff"
  description="HTTP errors developers see when a replacement model rejects a setting, or when a retired model id is still in the request. Grouped by provider, each with its source."
  crumbs={[{ name: "Home", path: "/" }, { name: "Request errors", path: REQUEST_ERRORS_INDEX }]}
  extraGraph={requestErrorsIndexGraph(site, items, requestErrorHubFaqs)}
>
  <h1>Request errors</h1>
  <p class="answer">
    These are the failures that show up after a model id change, or after a model id stops being accessible.
    Each row has the error text, the model change that causes it, and a link to the fix.
    Sources on the earlier pages were checked {checked} ({REQUEST_ERRORS_CHECKED}).
    The thinking budget page was checked October 21, 2026.
    The API version 2026-10-21 sampling page was checked October 22, 2026.
    The temperature page, the Gemini 2.5 new-user page, and the Azure 410 page were checked October 24, 2026.
    The DeepSeek model_not_found page was checked October 25, 2026.
    The Chat Completions user field page was checked October 26, 2026.
    The NVIDIA hosted 410 page was checked October 27, 2026.
    The Cloudflare Workers AI 410 page was checked October 31, 2026.
    The Claude Opus 4.8 fast mode page was checked October 31, 2026.
    The Bedrock end of life page was checked October 31, 2026.
    How a caught shutdown error can leave a job green is in <a href="/guides/silent-failures-after-model-shutdown/">Silent failures after a model shutdown</a>.
    The machine-readable list of settings a replacement rejects is <a href="/breaking-changes/">Breaking changes</a>.
    What the provider says happens on the shutdown date is in <a href="/guides/what-happens-on-model-shutdown-day/">What happens on shutdown day</a>.
  </p>
  {requestErrorProviders.map((provider) => {
    const pages = requestErrorsForProvider(provider.id);
    return (
      <section>
        <h2>{provider.name}</h2>
        <table>
          <caption>{pages.length} {provider.name} request errors.</caption>
          <thead>
            <tr><th>Error</th><th>Model change</th><th>Page</th></tr>
          </thead>
          <tbody>
            {pages.map((page) => (
              <tr>
                <td>{page.errorQuoted ? <code>{page.errorText}</code> : page.errorText}</td>
                <td>{page.cause}</td>
                <td><a href={requestErrorPath(page.slug)}>{page.h1}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    );
  })}
  <FaqList items={requestErrorHubFaqs} />
</Base>
