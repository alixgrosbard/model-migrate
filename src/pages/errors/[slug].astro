---
import Base from "../../layouts/Base.astro";
import FaqList from "../../components/FaqList.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import { requestErrorGraph } from "../../jsonld.ts";
import { loadProviders } from "../../lib/load.ts";
import { REQUEST_ERRORS_INDEX, requestErrorChecked, requestErrorPath, requestErrors } from "../../lib/request-errors.ts";
import { DEFAULT_SITE_URL } from "../../lib/site.ts";

export function getStaticPaths() {
  return requestErrors.map((page) => ({ params: { slug: page.slug } }));
}

const page = requestErrors.find((item) => item.slug === Astro.params.slug);
if (!page) throw new Error("Missing error page");
const providers = await loadProviders();
const site = Astro.site?.href ?? `${DEFAULT_SITE_URL}/`;
const path = requestErrorPath(page.slug);
const related = requestErrors.filter((item) => item.provider === page.provider && item.slug !== page.slug);
const checked = new Date(`${requestErrorChecked(page)}T00:00:00Z`).toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
---
<Base
  title={page.title}
  description={page.description}
  crumbs={[{ name: "Home", path: "/" }, { name: "Request errors", path: REQUEST_ERRORS_INDEX }, { name: page.h1, path }]}
  extraGraph={requestErrorGraph(site, page)}
>
  <h1>{page.h1}</h1>
  <p class="answer">{page.lead}</p>
  {page.seeAlso?.length ? (
    <ul>
      {page.seeAlso.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
  ) : null}
  {page.apiVersionNote ? (
    <p>
      {page.apiVersionNote.text}{" "}
      <a href={page.apiVersionNote.href}>{page.apiVersionNote.label}</a>.
      Source: <a href={page.apiVersionNote.sourceUrl}>{page.apiVersionNote.sourceLabel}</a>, checked {page.apiVersionNote.checked}.
    </p>
  ) : null}
  {page.errorQuoted ? (
    <>
      <h2>Error text</h2>
      <pre><code>{page.errorText}</code></pre>
      {page.quoteSourceUrl && page.quoteSourceLabel ? (
        <p>Quoted from <a href={page.quoteSourceUrl}>{page.quoteSourceLabel}</a>, checked {checked}.</p>
      ) : null}
    </>
  ) : (
    <>
      <h2>What fails</h2>
      <p>{page.errorText}</p>
    </>
  )}
  <p>
    {page.rule}{" "}
    Source: <a href={page.ruleSourceUrl}>{page.ruleSourceLabel}</a>, checked {checked}.
  </p>
  <h2>Affected models</h2>
  <table>
    <caption>{page.modelsCaption ?? "Models named on the official page for this failure."}</caption>
    <thead><tr><th>Model id</th><th>What the source says</th></tr></thead>
    <tbody>
      {page.models.map((model) => (
        <tr>
          <td><a href={`/models/${model.provider}/${model.slug}/`}><code>{model.id}</code></a></td>
          <td>{model.note}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <h2>Fix</h2>
  {page.fixes.map((fix) => (
    <section>
      <h3>{fix.heading}</h3>
      {fix.text.map((paragraph) => <p>{paragraph}</p>)}
      {fix.samples.map((sample) => (
        <div>
          <h4>{sample.caption}</h4>
          <pre><code>{sample.code}</code></pre>
        </div>
      ))}
      <p>Source: <a href={fix.sourceUrl}>{fix.sourceLabel}</a>, checked {checked}.</p>
    </section>
  ))}
  {page.shutdowns?.length ? (
    <>
      <h2>Shutdown pages</h2>
      <ul>
        {page.shutdowns.map((item) => (
          <li>
            <a href={`/shutdowns/${item.provider}-${item.date}/`}>
              {item.provider === "openai"
                ? "OpenAI October 23, 2026 batch"
                : item.provider === "google-gemini-api"
                  ? "Gemini API October 22, 2026 batch"
                  : item.provider === "azure-openai"
                    ? "Azure OpenAI November 19, 2026 batch"
                    : item.provider === "cloudflare-workers-ai"
                      ? "Cloudflare Workers AI May 30, 2026 batch"
                      : `${item.provider} ${item.date}`}
            </a>
          </li>
        ))}
      </ul>
    </>
  ) : null}
  {page.guides.length ? (
    <>
      <h2>Switch guides</h2>
      <ul>
        {page.guides.map((guide) => (
          <li><a href={guide.href}>{guide.label}</a></li>
        ))}
      </ul>
    </>
  ) : null}
  {related.length ? (
    <>
      <h2>More request errors</h2>
      <ul>
        {related.map((item) => (
          <li><a href={requestErrorPath(item.slug)}>{item.h1}</a></li>
        ))}
      </ul>
    </>
  ) : null}
  <p><a href={REQUEST_ERRORS_INDEX}>All request errors</a></p>
  <FaqList items={page.faqs} />
  <NewsletterForm providers={providers} sourcePage={path} />
</Base>
