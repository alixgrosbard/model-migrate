---
import Base from "../../layouts/Base.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import { loadProviders } from "../../lib/load.ts";
import { proCheckoutUrl } from "../../lib/public-copy.ts";

const providers = await loadProviders();
const checkout = proCheckoutUrl(import.meta.env.PUBLIC_PRO_CHECKOUT_URL);
---
<Base
  title="SunsetDiff Pro, $19 a month | SunsetDiff"
  description="SunsetDiff Pro is planned at $19 a month. Alerts for models in your code, earlier warnings, and API access are planned, not available yet."
  crumbs={[{ name: "Home", path: "/" }, { name: "Pro", path: "/pro/" }]}
>
  <h1>SunsetDiff Pro</h1>
  <p class="answer">SunsetDiff Pro is planned at $19 a month. Nothing on this list is available yet.</p>
  <h2>Planned</h2>
  <ul>
    <li>Alerts only for the models in your code. Planned.</li>
    <li>Earlier warnings. Planned.</li>
    <li>API access. Planned. The public JSON files on this site stay free.</li>
  </ul>
  {checkout ? (
    <p><a class="button" href={checkout}>Subscribe for $19 a month</a></p>
  ) : (
    <>
      <p><strong>Coming soon.</strong> There is no checkout link yet.</p>
      <NewsletterForm providers={providers} sourcePage="/pro/" />
    </>
  )}
</Base>
