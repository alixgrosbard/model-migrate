---
import Base from "../../layouts/Base.astro";
import MigrationCard from "../../components/MigrationCard.astro";
import { loadMigrations, loadModels, loadProviders } from "../../lib/load.ts";
import { migrateGraph } from "../../jsonld.ts";

export async function getStaticPaths() {
  const migrations = await loadMigrations();
  return migrations.map((migration) => ({
    params: { pair: `${migration.from.provider}__${migration.from.slug}__to__${migration.to.provider}__${migration.to.slug}` },
  }));
}
const migrations = await loadMigrations();
const models = await loadModels();
const providers = await loadProviders();
const migration = migrations.find((item) => `${item.from.provider}__${item.from.slug}__to__${item.to.provider}__${item.to.slug}` === Astro.params.pair);
if (!migration) throw new Error("Missing migration");
const from = models.find((model) => model.provider === migration.from.provider && model.slug === migration.from.slug);
const to = models.find((model) => model.provider === migration.to.provider && model.slug === migration.to.slug);
if (!from || !to) throw new Error("Missing model for migration");
const provider = providers.find((item) => item.id === from.provider)!;
const answer = `The official replacement for ${from.display_name} is ${to.id}.`;
const description = `${answer} Checked ${migration.last_checked}.`;
const site = Astro.site?.href ?? "https://sunsetdiff.onrender.com/";
---
<Base
  title={`${from.display_name} to ${to.display_name} migration diff | SunsetDiff`}
  description={description}
  crumbs={[
    { name: "Home", path: "/" },
    { name: from.display_name, path: `/models/${from.provider}/${from.slug}/` },
    { name: "Migration", path: `/migrate/${Astro.params.pair}/` },
  ]}
  extraGraph={migrateGraph(site, from, migration, provider)}
>
  <h1>Replacement for {from.display_name}: what changes when you switch</h1>
  <p class="answer">{answer}</p>
  <p>This is the canonical diff. <a href={`/models/${from.provider}/${from.slug}/`}>Model page</a></p>
  <MigrationCard migration={migration} from={from} to={to} />
  <h2>Price answers</h2>
  <p>{migration.price_diff.example_monthly_cost_old == null || migration.price_diff.example_monthly_cost_new == null ? "A full price comparison is not published. One or both prices are missing from the official pages we checked." : migration.price_diff.example_monthly_cost_new < migration.price_diff.example_monthly_cost_old ? `Yes. The labeled example monthly cost is $${migration.price_diff.example_monthly_cost_old} for the old model and $${migration.price_diff.example_monthly_cost_new} for the replacement.` : migration.price_diff.example_monthly_cost_new > migration.price_diff.example_monthly_cost_old ? `No. The labeled example monthly cost is $${migration.price_diff.example_monthly_cost_old} for the old model and $${migration.price_diff.example_monthly_cost_new} for the replacement.` : `The labeled example monthly cost is the same: $${migration.price_diff.example_monthly_cost_old}.`}</p>
  <h2>Context answer</h2>
  <p>{migration.context_diff.old_tokens == null || migration.context_diff.new_tokens == null ? "Context window sizes are not both published on the official pages we checked." : migration.context_diff.new_tokens > migration.context_diff.old_tokens ? `Yes. The context window changes from ${migration.context_diff.old_tokens.toLocaleString("en-US")} to ${migration.context_diff.new_tokens.toLocaleString("en-US")} tokens.` : migration.context_diff.new_tokens < migration.context_diff.old_tokens ? `No. The context window changes from ${migration.context_diff.old_tokens.toLocaleString("en-US")} to ${migration.context_diff.new_tokens.toLocaleString("en-US")} tokens.` : `The context window stays ${migration.context_diff.old_tokens.toLocaleString("en-US")} tokens.`}</p>
</Base>
