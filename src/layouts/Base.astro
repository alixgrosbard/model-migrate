---
import "../styles/global.css";
import { breadcrumb, graph, websiteGraph } from "../jsonld.ts";
import { loadModels, loadProviders } from "../lib/load.ts";
import { monthLabel, shutdownMonths } from "../lib/growth.ts";
import { DEFAULT_SITE_URL } from "../lib/site.ts";

interface Crumb { name: string; path: string; }
interface Props {
  title: string;
  description: string;
  crumbs: Crumb[];
  extraGraph?: unknown[];
  image?: string;
}
const { title, description, crumbs, extraGraph = [], image = "/og/sunsetdiff.svg" } = Astro.props;
const providers = await loadProviders();
const months = shutdownMonths(await loadModels());
const site = Astro.site?.href ?? `${DEFAULT_SITE_URL}/`;
const canonical = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;
const jsonld = graph([...websiteGraph(site), breadcrumb(site, crumbs), ...extraGraph]);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="SunsetDiff new deprecations" href="/feed.xml" />
    <link rel="alternate" type="text/calendar" title="SunsetDiff deadlines" href="/deadlines.ics" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header>
      <a class="brand" href="/">SunsetDiff</a>
      <nav aria-label="Main">
        <a href="/calendar/">Calendar</a>
        <a href="/deadlines/">Deadlines</a>
        <a href="/shutdowns/">Shutdowns</a>
        <a href="/feed.xml">Feed</a>
        <a href="/deadlines.ics">iCal</a>
        <a href="/questions/">Questions</a>
        <a href="/scan/">Scan</a>
        <a href="/changes/">Changes</a>
        <a href="/data/">Data</a>
        <a href="/about/">About</a>
        <a href="/pro/">Pro</a>
        <a href="/sponsor/">Sponsor</a>
      </nav>
      <nav class="months" aria-label="Shutdown months">
        {months.map((month) => <a href={`/deadlines/${month}/`}>{monthLabel(month)}</a>)}
      </nav>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer>
      <nav aria-label="Site">
        <a href="/deadlines/">Deadlines</a>
        <a href="/shutdowns/">Shutdowns</a>
        <a href="/feed.xml">Feed</a>
        <a href="/deadlines.ics">iCal</a>
        <a href="/questions/">Questions</a>
        <a href="/scan/">Scan</a>
        <a href="/data/">Dataset</a>
      </nav>
      <nav class="months" aria-label="Shutdown months">
        {months.map((month) => <a href={`/deadlines/${month}/`}>{monthLabel(month)}</a>)}
      </nav>
      <nav aria-label="Providers">
        {providers.map((provider) => <a href={`/providers/${provider.id}/`}>{provider.name}</a>)}
      </nav>
      <p>Publisher: SunsetDiff. Dates come from official provider pages. Data is <a href="/DATA_LICENSE.txt">CC BY 4.0</a>. Code is <a href="/LICENSE.txt">MIT</a>. <a href="/data/">Dataset</a></p>
    </footer>
  </body>
</html>
